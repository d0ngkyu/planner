<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_companion" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="플래너 캐릭터" android:src="@drawable/companion_happy" />
        <TextView android:id="@+id/widget_companion_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="10dp" android:textSize="13sp" android:textColor="#657169" />
    </LinearLayout>
    <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#3B6E5C" android:textStyle="bold" />
    <TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="14dp" android:paddingBottom="10dp" android:textSize="16sp" android:textColor="#242C28" android:maxLines="13" android:ellipsize="end" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#657169" />
</LinearLayout>
