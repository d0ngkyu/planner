rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인한 본인 데이터만 읽고 쓸 수 있다 (records, meta/settings, devices, pings)
    match /users/{uid}/{col}/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && col in ['records', 'meta', 'devices', 'pings'];
    }
  }
}
